# Copy to .env; shell environment wins over this file.
# Edge sends reply text to a cloud service. Set piper for local TTS.
AIVA_TTS=edge
LLM_PROVIDER=local
AIVA_LIVE_BOOKING=0
AIVA_LOG_TEXT=0

# Optional NVIDIA LLM: sends transcript text to NVIDIA. Use test data.
# Set LLM_PROVIDER=nvidia and fill in both values below.
NVIDIA_API_KEY=
AIVA_NVIDIA_MODEL=
AIVA_NVIDIA_JSON_MODE=1
